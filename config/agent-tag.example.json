{
  "version": 1,
  "dataDir": "/var/lib/agent-tag/data",
  "t3": {
    "baseUrl": "http://127.0.0.1:37841",
    "tokenFile": "/var/lib/agent-tag/secrets/t3-token"
  },
  "slack": {
    "workspaceId": "T0EXAMPLE",
    "appTokenFile": "/var/lib/agent-tag/secrets/slack-app-token",
    "botTokenFile": "/var/lib/agent-tag/secrets/slack-bot-token"
  },
  "access": {
    "allowedUserIds": ["U0EXAMPLE"],
    "allowedChannelIds": ["C0EXAMPLE"]
  },
  "profiles": [
    {
      "id": "engineering",
      "repositoryRoots": ["/srv/agent-tag/repositories/example"],
      "baseBranch": "main",
      "defaultProviderInstanceId": "codex",
      "defaultModel": "gpt-5.6-sol",
      "allowedModels": [
        { "instanceId": "codex", "model": "gpt-5.6-mini", "label": "GPT-5.6 mini", "aliases": ["mini"] },
        { "instanceId": "claudeAgent", "model": "claude-opus-5-5", "label": "Opus 5.5", "aliases": ["opus"] }
      ],
      "runtimeMode": "approval-required",
      "isolation": {
        "mode": "trusted-same-user",
        "acknowledgedSharedMachineAccess": true
      },
      "externalWrites": {
        "mode": "approval-required",
        "allowedTools": ["github"]
      },
      "memory": {
        "shared": true,
        "privateDm": false,
        "retentionDays": 180
      },
      "ambient": {
        "enabled": false,
        "keywords": [],
        "cooldownSeconds": 300,
        "maxTurnsPerHour": 4
      },
      "pullRequests": {
        "mode": "off"
      }
    }
  ],
  "routes": [
    {
      "conversationId": "C0EXAMPLE",
      "conversationType": "channel",
      "profileId": "engineering",
      "repositoryRoot": "/srv/agent-tag/repositories/example"
    }
  ],
  "limits": {
    "maxConcurrentTasks": 2,
    "maxActiveSchedules": 100,
    "stalledTurn": {
      "timeoutSeconds": 300,
      "retryDelaySeconds": 30,
      "maxAttempts": 5,
      "maxTurnSeconds": 21600
    },
    "interactionExpirySeconds": 86400
  },
  "github": {
    "apiBaseUrl": "https://api.github.com",
    "webBaseUrl": "https://github.com",
    "auth": {
      "type": "token",
      "tokenFile": "/var/lib/agent-tag/secrets/github-token"
    }
  },
  "retention": {
    "messageDays": 30,
    "outboxDays": 30,
    "auditDays": 365
  },
  "routines": {
    "autoDisable": {
      "consecutiveFailures": 3,
      "minFailureSpanSeconds": 3600
    }
  }
}
