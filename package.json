{
  "name": "agent-tag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts run",
    "doctor": "bun run src/cli.ts doctor",
    "status": "bun run src/cli.ts status",
    "audit": "bun run src/cli.ts audit",
    "audit:verify": "bun run scripts/verify-audit.ts",
    "backup": "bun run src/cli.ts backup",
    "restore": "bun run src/cli.ts restore",
    "schedule:add": "bun run src/cli.ts schedule-add",
    "schedule:list": "bun run src/cli.ts schedule-list",
    "schedule:cancel": "bun run src/cli.ts schedule-cancel",
    "scan:secrets": "bun run scripts/scan-secrets.ts",
    "security:audit": "bun run src/cli.ts security audit",
    "prune": "bun run src/cli.ts prune",
    "service:install": "bun run scripts/manage-launchd.ts install",
    "service:upgrade": "bun run scripts/manage-launchd.ts upgrade",
    "service:status": "bun run scripts/manage-launchd.ts status",
    "service:uninstall": "bun run scripts/manage-launchd.ts uninstall",
    "test": "bun test",
    "test:t3": "RUN_T3_INTEGRATION=1 bun test test/t3-live.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "enroll:t3": "bun run scripts/enroll-t3.ts",
    "verify:t3-pin": "bun run scripts/verify-t3-pin.ts",
    "verify:clean-install": "bun run scripts/verify-clean-install.ts",
    "check": "bun run typecheck && bun test",
    "build:release": "bun run scripts/build-release.ts",
    "verify:slack-authority": "bun run scripts/verify-slack-authority.ts"
  },
  "dependencies": {
    "@slack/bolt": "5.1.0",
    "effect": "4.0.0-rc.115",
    "undici": "7.29.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.13"
}
