{
  "name": "agent-tag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts run",
    "doctor": "bun run src/cli.ts doctor",
    "audit": "bun run src/cli.ts audit",
    "backup": "bun run src/cli.ts backup",
    "restore": "bun run src/cli.ts restore",
    "test": "bun test",
    "test:t3": "RUN_T3_INTEGRATION=1 bun test test/t3-live.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "enroll:t3": "bun run scripts/enroll-t3.ts",
    "verify:t3-pin": "bun run scripts/verify-t3-pin.ts",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@slack/bolt": "5.1.0",
    "effect": "4.0.0-rc.112",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.13"
}
